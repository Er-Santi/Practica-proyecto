AGENTMAIL_API_KEY=am_replace_with_a_new_api_key
AGENTMAIL_INBOX_ID=your-inbox@agentmail.to
RECONNECT_INTERVAL_SECONDS=5
# Opcional: sobreescribe llm.enabled en config.yaml (true/false)
# USE_LLM=false
OPENROUTER_API_KEY=sk-or-v1-replace_with_your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
# 0 = usar el límite max_calls de config.yaml; el máximo absoluto es 60
MAX_LLM_CALLS=0
SIMULATION_SEED=42
